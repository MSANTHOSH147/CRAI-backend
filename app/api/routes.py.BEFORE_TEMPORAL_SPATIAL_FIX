            Mission.id
            == mission_id
        )
        .first()
    )

    if not mission:
        raise HTTPException(
            status_code=404,
            detail="Mission not found",
        )

    latest_data = []

    sensor_types = [
        "RGB",
        "THERMAL",
        "GPS",
        "ENVIRONMENT",
    ]

    for sensor_type in sensor_types:

        reading = (
            db.query(SensorData)
            .filter(
                SensorData.mission_id
                == mission_id,

                SensorData.sensor_type
                == sensor_type,
            )
            .order_by(
                SensorData.timestamp.desc()
            )
            .first()
        )

        if reading:
            latest_data.append(
                reading
            )

    return latest_data

def publish_live_observation(image_path: Path, payload: dict):
    """
    Publish the latest phone observation for the judge laptop.

    The existing CRAI analysis pipeline remains authoritative.
    This only creates a browser-readable live display copy.
    """

    try:
        LIVE_DIR.mkdir(parents=True, exist_ok=True)

        # Copy the actual uploaded phone image.
        from PIL import Image

        with Image.open(image_path) as img:
            img = img.convert("RGB")
            img.save(
                LIVE_IMAGE_FILE,
                format="JPEG",
                quality=92,
                optimize=True,
            )

        # Save latest CRAI result.
        with LIVE_RESULT_FILE.open(
            "w",
            encoding="utf-8",
        ) as f:
            json.dump(
                payload,
                f,
                ensure_ascii=False,
                default=str,
                indent=2,
            )

        return True

    except Exception as exc:
        print(
            "CRAI LIVE DISPLAY publish warning:",
            exc,
        )
        return False
