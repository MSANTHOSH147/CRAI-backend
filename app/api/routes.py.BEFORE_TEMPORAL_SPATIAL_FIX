@router.post(
    "/missions/analyze-cell",
)
def analyze_mission_cell_route(
    payload: dict,
):
    try:
        region = payload.get(
            "region"
        )

        position = int(
            payload.get(
                "position",
                0,
            )
        )

        previous_observations = (
            payload.get(
                "previous_observations",
                [],
            )
        )

        if not region:
            raise HTTPException(
                status_code=400,
                detail="Mission region is required.",
            )

        if not isinstance(
            previous_observations,
            list,
        ):
            raise HTTPException(
                status_code=400,
                detail=(
                    "previous_observations "
                    "must be a list."
                ),
            )

        return analyze_mission_cell(
            region=region,
            position=position,
            previous_observations=(
                previous_observations
            ),
        )

    except HTTPException:
        raise

    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=(
                "Mission AI analysis failed: "
                f"{str(exc)}"
            ),
        )


