@router.get(
    "/observations",
)
def get_observations(
    farm_id: int | None = None,
    zone_id: str | None = None,
    limit: int = 100,
    db: Session = Depends(get_db),
):
    """
    Return persisted CRAI field observations.

    Used by:
        - Overview
        - History
        - Reports
        - Field intelligence

    Optional filters:
        farm_id
        zone_id
        limit
    """

    # --------------------------------------------------------
    # SAFE LIMIT
    # --------------------------------------------------------

    limit = max(
        1,
        min(
            limit,
            500,
        ),
    )

    # --------------------------------------------------------
    # NORMALIZE ZONE
    # --------------------------------------------------------

    normalized_zone = None

    if zone_id:
        normalized_zone = (
            zone_id.strip().upper()
        )

    # --------------------------------------------------------
    # BUILD QUERY
    # --------------------------------------------------------

    query = (
        db.query(
            FieldObservation
        )
    )

    if farm_id is not None:

        query = query.filter(
            FieldObservation.farm_id
            == farm_id
        )

    if normalized_zone:

        query = query.filter(
            FieldObservation.zone_id
            == normalized_zone
        )

    # --------------------------------------------------------
    # FETCH LATEST OBSERVATIONS
    # --------------------------------------------------------

    observations = (
        query
        .order_by(
            FieldObservation.observed_at.desc()
        )
        .limit(limit)
        .all()
    )

    # --------------------------------------------------------
    # SERIALIZE
    # --------------------------------------------------------

    result = []

    for item in observations:

        result.append(
            {
                "id":
                    item.id,

                "observation_id":
                    item.observation_id,

                "farm_id":
                    item.farm_id,

                "zone_id":
                    item.zone_id,

                "crop":
                    item.crop,

                "growth_stage":
                    item.growth_stage,

                "observed_at": (
                    item.observed_at.isoformat()
                    if item.observed_at
                    else None
                ),

                "filename":
                    item.filename,

                "prediction":
                    item.prediction,

                "disease_confidence":
                    item.disease_confidence,

                "risk_score":
                    item.risk_score,

                "risk_level":
                    item.risk_level,

                "assessment_confidence":
                    item.assessment_confidence,

                "soil_moisture":
                    item.soil_moisture,

                "temperature":
                    item.temperature,

                "humidity":
                    item.humidity,

                "thermal_anomaly":
                    item.thermal_anomaly,

                "evidence_breakdown":
                    item.evidence_breakdown,

                "evidence_summary":
                    item.evidence_summary,

                "source":
                    item.source,
            }
        )

    # --------------------------------------------------------
    # RESPONSE
    # --------------------------------------------------------

    return {
        "observations":
            result,

        "count":
            len(result),
    }


