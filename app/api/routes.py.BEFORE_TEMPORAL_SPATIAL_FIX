@router.post(
    "/farms",
    response_model=FarmResponse,
)
def create_farm(
    farm: FarmCreate,
    db: Session = Depends(get_db),
):
    existing_farm = (
        db.query(Farm)
        .filter(
            Farm.farm_code == farm.farm_code
        )
        .first()
    )

    if existing_farm:
        raise HTTPException(
            status_code=400,
            detail="Farm code already exists",
        )

    new_farm = Farm(
        farm_code=farm.farm_code,
        name=farm.name,
        crop=farm.crop,
        area_acres=farm.area_acres,
        latitude=farm.latitude,
        longitude=farm.longitude,
    )

    db.add(new_farm)
    db.commit()
    db.refresh(new_farm)

    return new_farm


