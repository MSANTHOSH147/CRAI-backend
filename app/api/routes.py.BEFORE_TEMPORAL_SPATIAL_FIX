        )


@router.post("/analysis/uav")
async def analyze_uav_image(
    file: UploadFile = File(...),
):
    """
    Analyze an aerial/UAV image using the CRAI UAV detector.

    This endpoint produces spatial evidence only.
    It does not independently calculate CRAI field risk.
    """

    if not file.filename:
        raise HTTPException(
            status_code=400,
            detail="UAV image filename is required.",
        )

    allowed_extensions = {
        ".jpg",
        ".jpeg",
        ".png",
        ".webp",
    }

    extension = Path(
        file.filename
    ).suffix.lower()

    if extension not in allowed_extensions:
        raise HTTPException(
            status_code=400,
            detail=(
                "Unsupported UAV image format. "
                "Use JPG, JPEG, PNG, or WEBP."
            ),
        )

    temp_dir = (
        Path(__file__).resolve().parents[2]
        / "uploads"
        / "uav"
    )

    temp_dir.mkdir(
        parents=True,
        exist_ok=True,
    )

    temp_path = (
        temp_dir
        / f"uav_{uuid.uuid4().hex}{extension}"
    )

    try:

        with temp_path.open(
            "wb"
        ) as buffer:

            shutil.copyfileobj(
                file.file,
                buffer,
            )

        result = detect_uav(
            temp_path
        )

        return {
            "success": True,
            "source": "uav",
            "filename": file.filename,
            "evidence": result,
        }

    except Exception as exc:

        raise HTTPException(
            status_code=500,
            detail=(
                "UAV image analysis failed: "
                f"{str(exc)}"
            ),
        )

    finally:

        try:
            if temp_path.exists():
                temp_path.unlink()

        except Exception:
            pass

