@app.post("/api/risk/analyze")
def analyze_risk(request: RiskAnalysisRequest):

    try:
        result = predict_risk(
            request.model_dump()
        )

        return result

    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=f"Risk AI prediction failed: {exc}",
        )


